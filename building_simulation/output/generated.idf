! ######
! HVAC - HEAT EXCHANGER TO SH TANK
! ######

PlantLoop,
  plantloop_hx_sh,                        !- Name
  Water,                                  !- Fluid Type
  ,                                       !- User Defined Fluid Type
  plantloop_hx_sh Operation Schemes,      !- Plant Equipment Operation Scheme Name
  node_hx_sh_5,                           !- Loop Temperature Setpoint Node Name
  100,                                    !- Maximum Loop Temperature {C}
  0,                                      !- Minimum Loop Temperature {C}
  Autosize,                               !- Maximum Loop Flow Rate {m3/s}
  0,                                      !- Minimum Loop Flow Rate {m3/s}
  Autocalculate,                          !- Plant Loop Volume {m3}
  node_hx_sh_1,                           !- Plant Side Inlet Node Name
  node_hx_sh_5,                           !- Plant Side Outlet Node Name
  plantloop_hx_sh Supply Branches,        !- Plant Side Branch List Name
  plantloop_hx_sh Supply Connector List,  !- Plant Side Connector List Name
  node_hx_sh_6,                           !- Demand Side Inlet Node Name
  node_hx_sh_9,                           !- Demand Side Outlet Node Name
  plantloop_hx_sh Demand Branches,        !- Demand Side Branch List Name
  plantloop_hx_sh Demand Connector List,  !- Demand Side Connector List Name
  SequentialLoad,                                !- Load Distribution Scheme
  plantloop_hx_sh_avm_list,                                       !- Availability Manager List Name
  SingleSetpoint,                         !- Plant Loop Demand Calculation Scheme
  None;                                   !- Common Pipe Simulation

AvailabilityManagerAssignmentList,
  plantloop_hx_sh_avm_list,        !- Name
  AvailabilityManager:Scheduled,   !- Availability Manager 1 Object Type
  plantloop_hx_sh_avail_manager;   !- Availability Manager 1 Name

AvailabilityManager:Scheduled,
  plantloop_hx_sh_avail_manager,   !- Name
  schedule_summer_off;     !- Schedule Name

Schedule:Compact,
  schedule_summer_off,  !- Name
  On/Off,                       !- Schedule Type Limits Name
  Through: 05/14,  For: AllDays, Until: 24:00, 1,   ! before May 15 -> ON
  Through: 09/30,  For: AllDays, Until: 24:00, 0,   ! May 15–Sep 30 -> OFF
  Through: 12/31,  For: AllDays, Until: 24:00, 1;   ! Oct 1–Dec 31 -> ON

Sizing:Plant,
  plantloop_hx_sh,                        !- Plant or Condenser Loop Name
  Heating,                                !- Loop Type
  58,                                     !- Design Loop Exit Temperature {C}
  2,                                      !- Loop Design Temperature Difference {deltaC}
  NonCoincident,                          !- Sizing Option
  1,                                      !- Zone Timesteps in Averaging Window
  None;                                   !- Coincident Sizing Factor Mode


SetpointManager:Scheduled,
  setpoint_loop_hx_sh,                    !- Name
  Temperature,                            !- Control Variable
  schedule_setpoint_loop_hx_sh,           !- Schedule Name
  node_hx_sh_5;                           !- Setpoint Node or NodeList Name

Schedule:Constant,
  schedule_setpoint_loop_hx_sh,           !- Name
  ,                                       !- Schedule Type Limits Name
  37.5;                                     !- Hourly Value

!Schedule:Compact,
!  schedule_setpoint_loop_hx_sh,              !- Name
!  Temperature,                          !- Schedule Type Limits Name
!  Through: 12/31,                       
!  For: AllDays, 
!  Until: 12:00,                             !- Time preheating N {hh:mm}
!  37.5,          !- Value Until Time N T preheating
!  Until: 17:00,                          !- Time 1 {hh:mm}
!  38.5,               !- Value Until Time 1
!  Until: 24:00,                                  !- Time 3 {hh:mm}
!  37.5;               !- Value Until Time 3



BranchList,
  plantloop_hx_sh Supply Branches,        !- Name
  plantloop_hx_sh Supply Inlet Branch,    !- Branch Name 1
  plantloop_hx_sh Supply Branch 1,        !- Branch Name 2
  plantloop_hx_sh Supply Outlet Branch;   !- Branch Name 3

ConnectorList,
  plantloop_hx_sh Supply Connector List,  !- Name
  Connector:Splitter,                     !- Connector Object Type 1
  plantloop_hx_sh Supply Splitter,        !- Connector Name 1
  Connector:Mixer,                        !- Connector Object Type 2
  plantloop_hx_sh Supply Mixer;           !- Connector Name 2

Connector:Splitter,
  plantloop_hx_sh Supply Splitter,        !- Name
  plantloop_hx_sh Supply Inlet Branch,    !- Inlet Branch Name
  plantloop_hx_sh Supply Branch 1;        !- Outlet Branch Name 1

Connector:Mixer,
  plantloop_hx_sh Supply Mixer,           !- Name
  plantloop_hx_sh Supply Outlet Branch,   !- Outlet Branch Name
  plantloop_hx_sh Supply Branch 1;        !- Inlet Branch Name 1

Branch,
  plantloop_hx_sh Supply Inlet Branch,    !- Name
  ,                                       !- Pressure Drop Curve Name
  Pump:VariableSpeed,                     !- Component Object Type 1
  pump_hx_sh,                             !- Component Name 1
  node_hx_sh_1,                           !- Component Inlet Node Name 1
  node_hx_sh_2;                           !- Component Outlet Node Name 1

Pump:VariableSpeed,
  pump_hx_sh,                             !- Name
  node_hx_sh_1,                           !- Inlet Node Name
  node_hx_sh_2,                           !- Outlet Node Name
  Autosize,                               !- Design Maximum Flow Rate {m3/s}
  20000,                                 !- Design Pump Head {Pa} ( def. 179352) (def. 30000)
  Autosize,                               !- Design Power Consumption {W}
  0.9,                                    !- Motor Efficiency
  0,                                      !- Fraction of Motor Inefficiencies to Fluid Stream
  0,                                      !- Coefficient 1 of the Part Load Performance Curve
  1,                                      !- Coefficient 2 of the Part Load Performance Curve
  0,                                      !- Coefficient 3 of the Part Load Performance Curve
  0,                                      !- Coefficient 4 of the Part Load Performance Curve
  0,                                      !- Design Minimum Flow Rate {m3/s}
  Intermittent,                             !- Pump Control Type
  ,                                       !- Pump Flow Rate Schedule Name
  ,                                       !- Pump Curve Name
  ,                                       !- Impeller Diameter {m}
  ,                                       !- VFD Control Type
  ,                                       !- Pump RPM Schedule Name
  ,                                       !- Minimum Pressure Schedule {Pa}
  ,                                       !- Maximum Pressure Schedule {Pa}
  ,                                       !- Minimum RPM Schedule {rev/min}
  ,                                       !- Maximum RPM Schedule {rev/min}
  ,                                       !- Zone Name
  1,                                    !- Skin Loss Radiative Fraction
  PowerPerFlowPerPressure,                !- Design Power Sizing Method
  348701.1,                               !- Design Electric Power per Unit Flow Rate {W/(m3/s)}
  1.282051282,                            !- Design Shaft Power per Unit Flow Rate per Unit Head {W/((m3/s)-Pa)}
  0,                                      !- Design Minimum Flow Rate Fraction
  General;                                !- End-Use Subcategory

Branch,
  plantloop_hx_sh Supply Branch 1,        !- Name
  ,                                       !- Pressure Drop Curve Name
  HeatExchanger:FluidToFluid,             !- Component Object Type 1
  hx_sh,                                  !- Component Name 1
  node_hx_sh_3,                           !- Component Inlet Node Name 1
  node_hx_sh_4;                           !- Component Outlet Node Name 1

Branch,
  plantloop_hx_sh Supply Outlet Branch,   !- Name
  ,                                       !- Pressure Drop Curve Name
  Pipe:Adiabatic,                         !- Component Object Type 1
  plantloop_hx_sh Supply Outlet Pipe,     !- Component Name 1
  plantloop_hx_sh Supply Outlet Pipe Node, !- Component Inlet Node Name 1
  node_hx_sh_5;                           !- Component Outlet Node Name 1

Pipe:Adiabatic,
  plantloop_hx_sh Supply Outlet Pipe,     !- Name
  plantloop_hx_sh Supply Outlet Pipe Node, !- Inlet Node Name
  node_hx_sh_5;                           !- Outlet Node Name

BranchList,
  plantloop_hx_sh Demand Branches,        !- Name
  plantloop_hx_sh Demand Inlet Branch,    !- Branch Name 1
  plantloop_hx_sh Demand Branch 1,        !- Branch Name 2
  plantloop_hx_sh Demand Bypass Branch,   !- Branch Name 3
  plantloop_hx_sh Demand Outlet Branch;   !- Branch Name 4

ConnectorList,
  plantloop_hx_sh Demand Connector List,  !- Name
  Connector:Splitter,                     !- Connector Object Type 1
  plantloop_hx_sh Demand Splitter,        !- Connector Name 1
  Connector:Mixer,                        !- Connector Object Type 2
  plantloop_hx_sh Demand Mixer;           !- Connector Name 2

Connector:Splitter,
  plantloop_hx_sh Demand Splitter,        !- Name
  plantloop_hx_sh Demand Inlet Branch,    !- Inlet Branch Name
  plantloop_hx_sh Demand Branch 1,        !- Outlet Branch Name 1
  plantloop_hx_sh Demand Bypass Branch;   !- Outlet Branch Name 2

Connector:Mixer,
  plantloop_hx_sh Demand Mixer,           !- Name
  plantloop_hx_sh Demand Outlet Branch,   !- Outlet Branch Name
  plantloop_hx_sh Demand Branch 1,        !- Inlet Branch Name 1
  plantloop_hx_sh Demand Bypass Branch;   !- Inlet Branch Name 2

Branch,
  plantloop_hx_sh Demand Inlet Branch,    !- Name
  ,                                       !- Pressure Drop Curve Name
  Pipe:Adiabatic,                         !- Component Object Type 1
  plantloop_hx_sh Demand Inlet Pipe,      !- Component Name 1
  node_hx_sh_6,                           !- Component Inlet Node Name 1
  plantloop_hx_sh Demand Inlet Pipe Node; !- Component Outlet Node Name 1

Pipe:Adiabatic,
  plantloop_hx_sh Demand Inlet Pipe,      !- Name
  node_hx_sh_6,                           !- Inlet Node Name
  plantloop_hx_sh Demand Inlet Pipe Node; !- Outlet Node Name

! ===========================================================================
! IF THERE'S SH STORAGE -> ADD TANK; IF NO SH STORAGE -> ADD HEAT EXCHANGER
! ===========================================================================

 ! (if IS_TANK_SH == True)

Branch,
  plantloop_hx_sh Demand Branch 1,        !- Name
  ,                                       !- Pressure Drop Curve Name
  WaterHeater:Mixed,                      !- Component Object Type 1
  tank_sh,                                !- Component Name 1
  node_hx_sh_7,                           !- Component Inlet Node Name 1
  node_hx_sh_8;                           !- Component Outlet Node Name 1


! ===========================================================================
! ===========================================================================

Schedule:Compact,
  tank_env_temperature,      !- Name
  Temperature,                            !- Schedule Type Limits Name
  Through: 12/31,                         !- Field 1
  For: AllDays,                           !- Field 2
  Until: 24:00,                           !- Field 3
  18;                                     !- Field 4

Branch,
  plantloop_hx_sh Demand Bypass Branch,   !- Name
  ,                                       !- Pressure Drop Curve Name
  Pipe:Adiabatic,                         !- Component Object Type 1
  plantloop_hx_sh Demand Bypass Pipe,     !- Component Name 1
  plantloop_hx_sh Demand Bypass Pipe Inlet Node, !- Component Inlet Node Name 1
  plantloop_hx_sh Demand Bypass Pipe Outlet Node; !- Component Outlet Node Name 1

Pipe:Adiabatic,
  plantloop_hx_sh Demand Bypass Pipe,     !- Name
  plantloop_hx_sh Demand Bypass Pipe Inlet Node, !- Inlet Node Name
  plantloop_hx_sh Demand Bypass Pipe Outlet Node; !- Outlet Node Name

Branch,
  plantloop_hx_sh Demand Outlet Branch,   !- Name
  ,                                       !- Pressure Drop Curve Name
  Pipe:Adiabatic,                         !- Component Object Type 1
  plantloop_hx_sh Demand Outlet Pipe,     !- Component Name 1
  plantloop_hx_sh Demand Outlet Pipe Node, !- Component Inlet Node Name 1
  node_hx_sh_9;                           !- Component Outlet Node Name 1

Pipe:Adiabatic,
  plantloop_hx_sh Demand Outlet Pipe,     !- Name
  plantloop_hx_sh Demand Outlet Pipe Node, !- Inlet Node Name
  node_hx_sh_9;                           !- Outlet Node Name

PlantEquipmentOperationSchemes,
  plantloop_hx_sh Operation Schemes,      !- Name
  PlantEquipmentOperation:HeatingLoad,    !- Control Scheme Object Type 1
  plantloop_hx_sh Heating Operation Scheme, !- Control Scheme Name 1
  Always On Discrete;                     !- Control Scheme Schedule Name 1

PlantEquipmentOperation:HeatingLoad,
  plantloop_hx_sh Heating Operation Scheme, !- Name
  0,                                      !- Load Range Lower Limit 1 {W}
  1000000000,                             !- Load Range Upper Limit 1 {W}
  plantloop_hx_sh Heating Equipment List; !- Range Equipment List Name 1

PlantEquipmentList,
  plantloop_hx_sh Heating Equipment List, !- Name
  HeatExchanger:FluidToFluid,             !- Equipment Object Type 1
  hx_sh;                                  !- Equipment Name 1


