! ######
! HVAC - SOLAR COLLECTOR TO HX 
! ######

PlantLoop,
  plantloop_sol_hx,                       !- Name
  Water,                                  !- Fluid Type
  ,                                       !- User Defined Fluid Type
  plantloop_sol_hx Operation Schemes,     !- Plant Equipment Operation Scheme Name
  node_sol_hx_5,                          !- Loop Temperature Setpoint Node Name
  100,                                    !- Maximum Loop Temperature {C}
  0,                                      !- Minimum Loop Temperature {C}
  Autosize,                               !- Maximum Loop Flow Rate {m3/s}
  0,                                      !- Minimum Loop Flow Rate {m3/s}
  Autocalculate,                          !- Plant Loop Volume {m3}
  node_sol_hx_1,                          !- Plant Side Inlet Node Name
  node_sol_hx_5,                          !- Plant Side Outlet Node Name
  plantloop_sol_hx Supply Branches,       !- Plant Side Branch List Name
  plantloop_sol_hx Supply Connector List, !- Plant Side Connector List Name
  node_sol_hx_6,                          !- Demand Side Inlet Node Name
  node_sol_hx_9,                          !- Demand Side Outlet Node Name
  plantloop_sol_hx Demand Branches,       !- Demand Side Branch List Name
  plantloop_sol_hx Demand Connector List, !- Demand Side Connector List Name
  SequentialLoad,                                !- Load Distribution Scheme
  plantloop_sol_hx_AvailabilityManagerAssignmentList,  !- Availability Manager List Name
  SingleSetpoint,                         !- Plant Loop Demand Calculation Scheme
  None;                                   !- Common Pipe Simulation

! ===========================================================================
! IF THERE'S SOLAR COLLECTOR -> AVAILABILITY IS ON; IF NO SOLAR COLLECTOR -> AVAILABILITY IS OFF
! ===========================================================================


AvailabilityManagerAssignmentList,
  plantloop_sol_hx_AvailabilityManagerAssignmentList, !- Name
  AvailabilityManager:DifferentialThermostat, !- Availability Manager Object Type 2
  plantloop_sol_hx_availabilityManager;   !- Availability Manager Name 2


AvailabilityManager:DifferentialThermostat,
  plantloop_sol_hx_availabilityManager,   !- Name
  node_sol_hx_4_0,                        !- Hot Node Name
  node_hx_dhw_2,                          !- Cold Node Name
  10,                                     !- Temperature Difference On Limit {deltaC}
  2;                                      !- Temperature Difference Off Limit {deltaC}

Schedule:Constant,
  schedule_hx_sol_availability,          !- Name
  ,                                       !- Schedule Type Limits Name
  1;                                     !- Hourly Value (= 0 if no solar)

! The solar loop starts circulating when the collector outlet is 10 °C hotter than the tank return.
! It stops when that difference falls below 2 °C.
! Between 2 °C and 10 °C, the "EMS" remembers its previous state (hysteresis).







! ===========================================================================
! ===========================================================================

Sizing:Plant,
  plantloop_sol_hx,                       !- Plant or Condenser Loop Name
  Heating,                                !- Loop Type
  90,                                     !- Design Loop Exit Temperature {C}
  2,                                     !- Loop Design Temperature Difference {deltaC}
  NonCoincident,                          !- Sizing Option
  1,                                      !- Zone Timesteps in Averaging Window
  None;                                   !- Coincident Sizing Factor Mode

SetpointManager:Scheduled,
  setpoint_loop_sol_hx,                   !- Name
  Temperature,                            !- Control Variable
  schedule_setpoint_loop_sol_hx,          !- Schedule Name
  node_sol_hx_5;                          !- Setpoint Node or NodeList Name

Schedule:Constant,
  schedule_setpoint_loop_sol_hx,          !- Name
  ,                                       !- Schedule Type Limits Name
  90;                                     !- Hourly Value

BranchList,
  plantloop_sol_hx Supply Branches,       !- Name
  plantloop_sol_hx Supply Inlet Branch,   !- Branch Name 1
  plantloop_sol_hx Supply Branch 1,       !- Branch Name 2
  plantloop_sol_hx Supply Branch 2,       !- Branch Name 3
  plantloop_sol_hx Supply Outlet Branch;  !- Branch Name 4

ConnectorList,
  plantloop_sol_hx Supply Connector List, !- Name
  Connector:Splitter,                     !- Connector Object Type 1
  plantloop_sol_hx Supply Splitter,       !- Connector Name 1
  Connector:Mixer,                        !- Connector Object Type 2
  plantloop_sol_hx Supply Mixer;          !- Connector Name 2

Connector:Splitter,
  plantloop_sol_hx Supply Splitter,       !- Name
  plantloop_sol_hx Supply Inlet Branch,   !- Inlet Branch Name
  plantloop_sol_hx Supply Branch 1,       !- Outlet Branch Name 1
  plantloop_sol_hx Supply Branch 2;       !- Outlet Branch Name 2

Connector:Mixer,
  plantloop_sol_hx Supply Mixer,          !- Name
  plantloop_sol_hx Supply Outlet Branch,  !- Outlet Branch Name
  plantloop_sol_hx Supply Branch 1,       !- Inlet Branch Name 1
  plantloop_sol_hx Supply Branch 2;       !- Inlet Branch Name 2

Branch,
  plantloop_sol_hx Supply Inlet Branch,   !- Name
  ,                                       !- Pressure Drop Curve Name
  Pump:VariableSpeed,                     !- Component Object Type 1
  pump_sol_hx,                            !- Component Name 1
  node_sol_hx_1,                          !- Component Inlet Node Name 1
  node_sol_hx_2;                          !- Component Outlet Node Name 1

Pump:VariableSpeed,
  pump_sol_hx,                            !- Name
  node_sol_hx_1,                          !- Inlet Node Name
  node_sol_hx_2,                          !- Outlet Node Name
  Autosize,                               !- Design Maximum Flow Rate {m3/s}
  20000,                                 !- Design Pump Head {Pa} ( def. 179352)
  Autosize,                               !- Design Power Consumption {W}
