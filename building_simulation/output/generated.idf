DesignSpecification:OutdoorAir:SpaceList,
  fl2_thz0 DSOA Space List,               !- Name
  fl2_thz0 Space,                         !- Space Name 1
  outdoorair_fl2_thz0;        !- Space Design Specification Outdoor Air Object Name 1

DesignSpecification:OutdoorAir, 
  outdoorair_fl2_thz0,        !- Name
  Sum,                                    !- Outdoor Air Method
  0,                                      !- Outdoor Air Flow per Person {m3/s-person}
  0.0003055556,                           !- Outdoor Air Flow per Zone Floor Area {m3/s-m2}
  0,                                      !- Outdoor Air Flow per Zone {m3/s}
  0;                                      !- Outdoor Air Flow Air Changes per Hour {1/hr}

