! ################
! COMMON INSTANCES - SCHEDULE LIMITS (ENERGYPLUS REQUIREMENT)
! ################

! ################
! COMMON INSTANCES - SCHEDULE TYPE LIMITS
! ################

ScheduleTypeLimits,
  Temperature,                            !- Name
  ,                                       !- Lower Limit Value {BasedOnField A3}
  ,                                       !- Upper Limit Value {BasedOnField A3}
  Continuous,                             !- Numeric Type
  temperature;                            !- Unit Type

ScheduleTypeLimits,
  Fractional,                               !- Name
  0,                                      !- Lower Limit Value {BasedOnField A3}
  1,                                      !- Upper Limit Value {BasedOnField A3}
  Continuous;                             !- Numeric Type

ScheduleTypeLimits,
  schedule_limits_thermostatControl, !- Name
  0,                                      !- Lower Limit Value {BasedOnField A3}
  4,                                      !- Upper Limit Value {BasedOnField A3}
  DISCRETE;                               !- Numeric Type

ScheduleTypeLimits,
  ActivityLevel,                          !- Name
  0,                                      !- Lower Limit Value {BasedOnField A3}
  ,                                       !- Upper Limit Value {BasedOnField A3}
  Continuous,                             !- Numeric Type
  activitylevel;                          !- Unit Type

ScheduleTypeLimits,
  Dimensionless,                          !- Name
  ,                                       !- Lower Limit Value {BasedOnField A3}
  ,                                       !- Upper Limit Value {BasedOnField A3}
  Continuous;                             !- Numeric Type


! ################
! HVAC - ENERGY MANAGEMENT SYSTEM (HP/BOILER CONTROL AT 2 DIFFERENT TEMPERATURES)
! ################


! no need of EMS as working with 1 water temperature is ok.


! ################
! HVAC - HP EFFICIENCY CURVES (COP AND HEATING CAPACITY)
! ################



! ######
! HVAC - HP CURVES
! ######


! ======================
! MODEL: AEROTOP G07-14M
! ======================

Curve:Biquadratic,
  HPWH EIR Func of Temp,        !- Name
  0.002127962797405887,            !- C1
  0.04551616724652642,                     !- C2 *X
  0.00012666718102110353,                     !- C3 *X^2
  -0.026550994253348035,           !- C4 *Y
  0.0013872188501457088,            !- C5 *Y^2
  -0.0011060410973828647,                     !- C6 *X*Y
  35,                      !- Minimum Value of x (Load-side outlet)
  55,                      !- Maximum Value of x (Load-side outlet)
  -10,                     !- Minimum Value of y (Source-side inlet)
  20,                      !- Maximum Value of y (Source-side inlet)
  1.0,                     !- Minimum Curve Output (normalized)
  3.9012398151,            !- Maximum Curve Output (normalized)
  Temperature,             !- Input Unit Type for X
  Temperature,             !- Input Unit Type for Y
  Dimensionless;           !- Output Unit Type

Curve:Biquadratic,
  HPWH Heating Cap Func Temp,        !- Name
  0.0015218659535927532,            !- C1
  0.03254671514433575,                     !- C2 *X
  -0.0003875976758410249,                     !- C3 *X^2
  0.009908336611295615,            !- C4 *Y
  0.0008053348336897272,            !- C5 *Y^2
  -0.0002659291554312742,                     !- C6 *X*Y
  35,                      !- Minimum Value of x (Load-side outlet)
  55,                      !- Maximum Value of x (Load-side outlet)
  -10,                     !- Minimum Value of y (Source-side inlet)
  20,                      !- Maximum Value of y (Source-side inlet)
  0.6122029422,            !- Minimum Curve Output (normalized)
  1.0000052825,                     !- Maximum Curve Output (normalized)
  Temperature,             !- Input Unit Type for X
  Temperature,             !- Input Unit Type for Y
  Dimensionless;           !- Output Unit Type

!Curve:Quadratic,
!  Part Load Frac Correlation,     !- Name
!  1,                 !- Coefficient1 C1 (1+alpha)
!  0,                !- Coefficient2 C2 (-2*alpha)
!  0,                 !- Coefficient3 C3 (alpha)
!  0.0,                  !- Minimum Value of x (PLR)
!  1.0,                  !- Maximum Value of x (PLR)
!  1.0,                  !- Minimum Curve Output
!  1.0,                  !- Maximum Curve Output
!  Dimensionless,        !- Input Unit Type for X
!  Dimensionless;        !- Output Unit Type


Curve:Quadratic,
  Part Load Frac Correlation,   !- Name ! https://chatgpt.com/share/6901d55e-31e8-8003-bec6-9151f8c1644f
  0.85,                       !- Coefficient1 C1  
  0.15,                       !- Coefficient2 C2
  0.00,                       !- Coefficient3 C3
  0.0,                        !- Minimum Value of x (PLR)
  1.0,                        !- Maximum Value of x (PLR)
  0.0,                        !- Minimum Curve Output
  1.0,                        !- Maximum Curve Output
  Dimensionless,              !- Input Unit Type for X
  Dimensionless;              !- Output Unit Type



!-END CURVES

! ################
! HVAC - BOILER EFFICIENCY CURVES
! ################

! ######
! HVAC - BOILER CURVES (DEFAULT)
! ######

Curve:Biquadratic,
  Boiler Efficiency,                      !- Name
  1,                                      !- Coefficient1 Constant
  0,                                      !- Coefficient2 x
  0,                                      !- Coefficient3 x**2
  0,                                      !- Coefficient4 y
  0,                                      !- Coefficient5 y**2
  0,                                      !- Coefficient6 x*y
  0,                                      !- Minimum Value of x {BasedOnField A2}
  1,                                      !- Maximum Value of x {BasedOnField A2}
  0,                                      !- Minimum Value of y {BasedOnField A3}
  1;                                      !- Maximum Value of y {BasedOnField A3}

!-END CURVES

! ################
! HVAC - THERMOSTAT CONTROL
! ################

! ######
! FLOOR N - THERMOSTAT CONTROL
! ######

 ! (e.g. if 4 fls TOTAL_FLOORS_LIST=[0...3])



ZoneControl:Thermostat:OperativeTemperature,
  fl0_thz0 Thermostat,          !- ZoneControl:Thermostat Name
  Constant,                   !- Radiative Fraction Input Mode
  0.5,                        !- Fixed Radiative Fraction
  ,                           !- Radiative Fraction Schedule
  AdaptiveASH55CentralLine;   !- Adaptive Comfort Model Type !!!! adaptive comfort models only apply to cooling mode 


ZoneControl:Thermostat,
  fl0_thz0 Thermostat,                    !- Name
  fl0_thz0,                               !- Zone or ZoneList Name
  schedule_thermostatControl_fl0_thz0,           !- Control Type Schedule Name
  ThermostatSetpoint:DualSetpoint,        !- Control 1 Object Type
  thermostatControl_fl0_thz0,      !- Control 1 Name
  ,                                       !- Control 2 Object Type
  ,                                       !- Control 2 Name
  ,                                       !- Control 3 Object Type
  ,                                       !- Control 3 Name
  ,                                       !- Control 4 Object Type
  ,                                       !- Control 4 Name
  0;                                      !- Temperature Difference Between Cutout And Setpoint {deltaC}

Schedule:Compact,
  schedule_thermostatControl_fl0_thz0,           !- Name
  schedule_limits_thermostatControl, !- Schedule Type Limits Name
  Through: 12/31,                         !- Field 1
  For: AllDays,                           !- Field 2
  Until: 24:00,                           !- Field 3
  4;                                      !- Field 4

ThermostatSetpoint:DualSetpoint,
  thermostatControl_fl0_thz0,      !- Name
  schedule_heatingsetpoint_fl0_thz0,      !- Heating Setpoint Temperature Schedule Name
  schedule_coolingsetpoint_fl0_thz0;      !- Cooling Setpoint Temperature Schedule Name

