Branch,
  plantloop_sh Supply Branch 1,           !- Name
  ,                                       !- Pressure Drop Curve Name
  WaterHeater:Mixed,                      !- Component Object Type 1
  tank_sh,                                !- Component Name 1
  node_sh_3,                              !- Component Inlet Node Name 1
  node_sh_4;                              !- Component Outlet Node Name 1

PlantEquipmentList,
  plantloop_sh Heating Equipment List,    !- Name
  WaterHeater:Mixed,                      !- Equipment Object Type 1
  tank_sh;                                !- Equipment Name 1

WaterHeater:Mixed,
  tank_sh,                                !- Name
  369,                                      !- Tank Volume {m3}
  setpoint_tank_sh,                       !- Setpoint Temperature Schedule Name
  0.01,                                    !- Deadband Temperature Difference {deltaC}
  82.22,                                  !- Maximum Temperature Limit {C}
  Cycle,                                  !- Heater Control Type
  0,                                      !- Heater Maximum Capacity {W}
  ,                                       !- Heater Minimum Capacity {W}
  0,                                      !- Heater Ignition Minimum Flow Rate {m3/s}
  0,                                      !- Heater Ignition Delay {s}
  NaturalGas,                             !- Heater Fuel Type
  0.8,                                    !- Heater Thermal Efficiency
  ,                                       !- Part Load Factor Curve Name
  20,                                     !- Off Cycle Parasitic Fuel Consumption Rate {W}
  NaturalGas,                             !- Off Cycle Parasitic Fuel Type
  0.8,                                    !- Off Cycle Parasitic Heat Fraction to Tank
  0,                                      !- On Cycle Parasitic Fuel Consumption Rate {W}
  NaturalGas,                             !- On Cycle Parasitic Fuel Type
  0,                                      !- On Cycle Parasitic Heat Fraction to Tank
  Schedule,                                   !- Ambient Temperature Indicator
  tank_env_temperature,                                       !- Ambient Temperature Schedule Name
  ,                               !- Ambient Temperature Zone Name
  ,                                       !- Ambient Temperature Outdoor Air Node Name
  6,                                      !- Off Cycle Loss Coefficient to Ambient Temperature {W/K}
  1,                                      !- Off Cycle Loss Fraction to Zone
  6,                                      !- On Cycle Loss Coefficient to Ambient Temperature {W/K}
  1,                                      !- On Cycle Loss Fraction to Zone
  ,                                       !- Peak Use Flow Rate {m3/s}
  ,                                       !- Use Flow Rate Fraction Schedule Name
  ,                                       !- Cold Water Supply Temperature Schedule Name
  node_sh_3,                              !- Use Side Inlet Node Name
  node_sh_4,                              !- Use Side Outlet Node Name
  1,                                      !- Use Side Effectiveness
  node_hx_sh_7,                           !- Source Side Inlet Node Name
  node_hx_sh_8,                           !- Source Side Outlet Node Name
  1,                                      !- Source Side Effectiveness
  Autosize,                               !- Use Side Design Flow Rate {m3/s}
  Autosize,                               !- Source Side Design Flow Rate {m3/s}
  0.1,                                    !- Indirect Water Heating Recovery Time {hr} SYSTEM SENSITIVE
  StorageTank,            !- Source Side Flow Control Mode
  ,                                       !- Indirect Alternate Setpoint Temperature Schedule Name
  General;                                !- End-Use Subcategory

!Schedule:Compact,
!  setpoint_tank_sh,      !- Name
!  Temperature,                            !- Schedule Type Limits Name
!  Through: 5/15,                         !- Field 1
!  For: AllDays,                           !- Field 2
!  Until: 24:00,                           !- Field 3
!  37.5,
!  Through: 9/30,
!  For: AllDays,                           !- Field 2
!  Until: 24:00,                           !- Field 3
!  10,
!  Through: 12/31,
!  For: AllDays,                           !- Field 2
!  Until: 24:00,                           !- Field 3
!  37.5;


Schedule:Compact,
  setpoint_tank_sh,              !- Name
  Temperature,                          !- Schedule Type Limits Name
  Through: 5/15,                       
  For: AllDays, 
  Until: 12:00,                             !- Time preheating N {hh:mm}
  37.5,          !- Value Until Time N T preheating
  Until: 17:00,                          !- Time 1 {hh:mm}
  38.5,               !- Value Until Time 1
  Until: 24:00,                                  !- Time 3 {hh:mm}
  37.5,               !- Value Until Time 3
  Through: 9/30,
  For: AllDays,                           !- Field 2
  Until: 24:00,                           !- Field 3
  10,
  Through: 12/31,
  For: AllDays,
  Until: 12:00,                             !- Time preheating N {hh:mm}
  37.5,          !- Value Until Time N T preheating
  Until: 17:00,                          !- Time 1 {hh:mm}
  38.5,               !- Value Until Time 1
  Until: 24:00,                                  !- Time 3 {hh:mm}
  37.5;               !- Value Until Time 3

!WaterHeater:Sizing,
!  tank_sh,                                !- WaterHeater Name
!  PeakDraw,                               !- Design Mode
!  0.538503,                               !- Time Storage Can Meet Peak Draw {hr}
!  0,                                      !- Time for Tank Recovery {hr}
!  1;                                      !- Nominal Tank Volume for Autosizing Plant Connections {m3}


! ===========================================================================
! ===========================================================================

BranchList,
  plantloop_sh Supply Branches,           !- Name
  plantloop_sh Supply Inlet Branch,       !- Branch Name 1
  plantloop_sh Supply Branch 1,           !- Branch Name 2
  plantloop_sh Supply Outlet Branch;      !- Branch Name 3

ConnectorList,
  plantloop_sh Supply Connector List,     !- Name
  Connector:Splitter,                     !- Connector Object Type 1
  plantloop_sh Supply Splitter,           !- Connector Name 1
  Connector:Mixer,                        !- Connector Object Type 2
  plantloop_sh Supply Mixer;              !- Connector Name 2

Connector:Splitter,
  plantloop_sh Supply Splitter,           !- Name
  plantloop_sh Supply Inlet Branch,       !- Inlet Branch Name
  plantloop_sh Supply Branch 1;           !- Outlet Branch Name 1

Connector:Mixer,
  plantloop_sh Supply Mixer,              !- Name
  plantloop_sh Supply Outlet Branch,      !- Outlet Branch Name
  plantloop_sh Supply Branch 1;           !- Inlet Branch Name 1

Branch,
  plantloop_sh Supply Inlet Branch,       !- Name
  ,                                       !- Pressure Drop Curve Name
  Pump:VariableSpeed,                     !- Component Object Type 1
  pump_sh,                                !- Component Name 1
  node_sh_1,                              !- Component Inlet Node Name 1
  node_sh_2;                              !- Component Outlet Node Name 1

Pump:VariableSpeed,
  pump_sh,                                !- Name
  node_sh_1,                              !- Inlet Node Name
  node_sh_2,                              !- Outlet Node Name
  Autosize,                               !- Design Maximum Flow Rate {m3/s}
  20000,                                 !- Design Pump Head {Pa} ( def. 179352)
  Autosize,                               !- Design Power Consumption {W}
  0.9,                                    !- Motor Efficiency
  0,                                      !- Fraction of Motor Inefficiencies to Fluid Stream
  0,                                      !- Coefficient 1 of the Part Load Performance Curve
  1,                                      !- Coefficient 2 of the Part Load Performance Curve
  0,                                      !- Coefficient 3 of the Part Load Performance Curve
  0,                                      !- Coefficient 4 of the Part Load Performance Curve
  0,                                      !- Design Minimum Flow Rate {m3/s}
  Intermittent,                             !- Pump Control Type
  ,                                       !- Pump Flow Rate Schedule Name
  ,                                       !- Pump Curve Name
  ,                                       !- Impeller Diameter {m}
  ,                                       !- VFD Control Type
  ,                                       !- Pump RPM Schedule Name
  ,                                       !- Minimum Pressure Schedule {Pa}
  ,                                       !- Maximum Pressure Schedule {Pa}
  ,                                       !- Minimum RPM Schedule {rev/min}
  ,                                       !- Maximum RPM Schedule {rev/min}
  ,                                       !- Zone Name
  0.5,                                    !- Skin Loss Radiative Fraction
  PowerPerFlowPerPressure,                !- Design Power Sizing Method
  348701.1,                               !- Design Electric Power per Unit Flow Rate {W/(m3/s)}
  1.282051282,                            !- Design Shaft Power per Unit Flow Rate per Unit Head {W/((m3/s)-Pa)}
  0,                                      !- Design Minimum Flow Rate Fraction
  General;                                !- End-Use Subcategory

Branch,
  plantloop_sh Supply Outlet Branch,      !- Name
  ,                                       !- Pressure Drop Curve Name
  Pipe:Adiabatic,                         !- Component Object Type 1
  plantloop_sh Supply Outlet Pipe,        !- Component Name 1
  plantloop_sh Supply Outlet Pipe Node,   !- Component Inlet Node Name 1
  node_sh_5;                              !- Component Outlet Node Name 1

Pipe:Adiabatic,
  plantloop_sh Supply Outlet Pipe,        !- Name
  plantloop_sh Supply Outlet Pipe Node,   !- Inlet Node Name
  node_sh_5;                              !- Outlet Node Name

BranchList,
  plantloop_sh Demand Branches,           !- Name
  plantloop_sh Demand Inlet Branch,       !- Branch Name 1
  plantloop_sh Demand Branch 0,           !- Branch Name 2
  plantloop_sh Demand Branch 1,           !- Branch Name 2
  plantloop_sh Demand Branch 2,           !- Branch Name 2
  plantloop_sh Demand Bypass Branch,      !- Branch Name 5
  plantloop_sh Demand Outlet Branch;      !- Branch Name 6

ConnectorList,
  plantloop_sh Demand Connector List,     !- Name
  Connector:Splitter,                     !- Connector Object Type 1
  plantloop_sh Demand Splitter,           !- Connector Name 1
  Connector:Mixer,                        !- Connector Object Type 2
  plantloop_sh Demand Mixer;              !- Connector Name 2

Connector:Splitter,
  plantloop_sh Demand Splitter,           !- Name
  plantloop_sh Demand Inlet Branch,       !- Inlet Branch Name
  plantloop_sh Demand Branch 0,           !- Branch Name 2
  plantloop_sh Demand Branch 1,           !- Branch Name 2
  plantloop_sh Demand Branch 2,           !- Branch Name 2
  plantloop_sh Demand Bypass Branch;      !- Outlet Branch Name 4

Connector:Mixer,
  plantloop_sh Demand Mixer,              !- Name
  plantloop_sh Demand Outlet Branch,      !- Outlet Branch Name
  plantloop_sh Demand Branch 0,           !- Branch Name 2
  plantloop_sh Demand Branch 1,           !- Branch Name 2
  plantloop_sh Demand Branch 2,           !- Branch Name 2
  plantloop_sh Demand Bypass Branch;      !- Inlet Branch Name 4

Branch,
  plantloop_sh Demand Inlet Branch,       !- Name
  ,                                       !- Pressure Drop Curve Name
  Pipe:Adiabatic,                         !- Component Object Type 1
  plantloop_sh Demand Inlet Pipe,         !- Component Name 1
  node_sh_6,                              !- Component Inlet Node Name 1
  plantloop_sh Demand Inlet Pipe Node;    !- Component Outlet Node Name 1

Pipe:Adiabatic,
  plantloop_sh Demand Inlet Pipe,         !- Name
  node_sh_6,                              !- Inlet Node Name
  plantloop_sh Demand Inlet Pipe Node;    !- Outlet Node Name

