! ## EMS SYSTEM ##
{% if IS_TANK_DHW %} ! (if IS_TANK_SH == True)

EnergyManagementSystem:Sensor, !- Actual Temp of the DHW tank
  DHW_Tank_T,                !- Name
  tank_dhw,                  !- Output:Variable or Output:Meter Index Key Name
  Water Heater Tank Temperature;  !- Output:Variable Name

{% else %} ! IF THERE IS NO TANK USE TEMP OF CIRCUIT INSTEAD

EnergyManagementSystem:Sensor, !- Equivalent Temp to the DHW tank
  DHW_Tank_T,                 
  node_dhw_5,                   
  System Node Temperature;

{% endif %}
  

{% if IS_TANK_SH %} ! (if IS_TANK_SH == True)

EnergyManagementSystem:Sensor, !- Actual Temp of the SH tank
  SH_Tank_T,                 
  tank_sh,                   
  Water Heater Tank Temperature;

{% else %} ! IF THERE IS NO TANK USE TEMP OF CIRCUIT INSTEAD

EnergyManagementSystem:Sensor, !- Equivalent Temp to the SH tank
  SH_Tank_T,                 
  node_sh_5,                   
  System Node Temperature;

{% endif %}

EnergyManagementSystem:Sensor, !- Setpoint of the DHW tank
  DHW_Setpoint,              !- Name
  node_hx_dhw_6,                  
  System Node Setpoint Temperature;

EnergyManagementSystem:Sensor, !- Setpoint of the SH tank
  SH_Setpoint,               
  node_hx_sh_5,                   
  System Node Setpoint Temperature;

EnergyManagementSystem:Actuator,
  HP_Temp_SP_Act,                          !- Actuator name
  schedule_setpoint_loop_gen,                        !- Actuated Component Unique Name
  Schedule:Constant,                       !- Actuated Component Type
  Schedule Value;                          !- Actuated Component Control Type

EnergyManagementSystem:Actuator,
  HX_DHW_OnOff_Act,                            !- Actuator Name
  HX_DHW_OnOff,                            !- Actuated Component Unique Name
  Schedule:Constant,                       !- Actuated Component Type
  Schedule Value;                          !- Actuated Component Control Type

EnergyManagementSystem:Actuator,
  HX_SH_OnOff_Act,                         !- Actuator name
  HX_SH_OnOff,                             !- Actuated Component Unique Name
  Schedule:Constant,                       !- Actuated Component Type
  Schedule Value;                          !- Actuated Component Control Type

EnergyManagementSystem:GlobalVariable,
  ModeIsDHW;

EnergyManagementSystem:Program,
  HP_Init,
  SET ModeIsDHW = 0;        ! safe default

EnergyManagementSystem:ProgramCallingManager,
  HP_Init_Caller,
  BeginNewEnvironment,
  HP_Init;


! HP DHW HX outlet (after hx_dhw)
EnergyManagementSystem:Sensor,
  HX_DHW_Outlet_T,                  !- Name
  node_hx_dhw_4_0,                  !- Output:Variable or Output:Meter Index Key Name
  System Node Temperature;          !- Output:Variable Name

! DHW HX loop demand (supply side)
EnergyManagementSystem:Sensor,
  DHW_Loop_Demand,                  !- Name
  plantloop_hx_dhw,                 !- Key Name
  Plant Supply Side Heating Demand Rate;   !- Variable

! Aux boiler activity (any >0 means boiler is doing the lift)
EnergyManagementSystem:Sensor,
  AuxBoiler_PLR,                    !- Name
  aux_heater_dhw,                   !- Key Name
  Boiler Part Load Ratio;           !- Variable


EnergyManagementSystem:Program,
  HP_Priority_Control,

  SET hyster_dhw = 7,
  SET hyster_sh  = 0.01,

  ! --- DHW need logic (any of these true will request DHW mode) ---
  SET need_hx = (HX_DHW_Outlet_T < (55 - 0.5)),              ! HX cannot maintain 55 C
  SET need_dem = (DHW_Loop_Demand > 50),                      ! loop is asking for heat (W)
  SET need_aux = (AuxBoiler_PLR > 0.01),                      ! boiler helping -> prefer DHW mode


  SET dhw_call = (need_hx && need_dem) || need_aux,           ! || need_draw

  ! --- SH call stays as you had it (based on SH tank / setpoint) ---
  SET sh_call  = (SH_Tank_T < (SH_Setpoint - hyster_sh)),

  ! --- Priority selection (keep previous Mode if no calls) ---
  IF (dhw_call),
    SET ModeIsDHW = 1,
  ELSEIF (sh_call),
    SET ModeIsDHW = 0,
  ENDIF,

  ! --- Set HP flow temperature by mode ---
  IF (ModeIsDHW == 1),
    SET HP_Temp_SP_Act = {{ dhw_flow_temperature_hp }},  ! e.g., 55
    SET HX_DHW_OnOff_Act = 1,
    SET HX_SH_OnOff_Act  = 0,
  ELSE,
    SET HP_Temp_SP_Act = {{ sh_flow_temperature }},      ! e.g., 35
    SET HX_DHW_OnOff_Act = 0,
    SET HX_SH_OnOff_Act  = 1,
  ENDIF,

  ! --- Summer: force SH off (as you had) ---
  IF ( (Month > 5 && Month < 9) || (Month == 5 && DayOfMonth >= 15) || (Month == 9 && DayOfMonth <= 30) ),
    SET HX_SH_OnOff_Act = 0,
  ENDIF;

EnergyManagementSystem:ProgramCallingManager,
  HP_Priority_Caller,
  InsideHVACSystemIterationLoop,
  HP_Priority_Control;


!- END EMS