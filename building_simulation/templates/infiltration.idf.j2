!- INFILTRATION

{% for fl in TOTAL_FLOORS_LIST %} ! (e.g. if 4 fls total_floors_list=[0...3])

ZoneInfiltration:DesignFlowRate,
  infiltration_fl{{ fl }}_thz0,                  !- Name
  fl{{ fl }}_thz0 Space,                         !- Zone or ZoneList or Space or SpaceList Name
  schedule_infiltration_fl{{ fl }}_thz0,                                       !- Schedule Name
  AirChanges/Hour,                        !- Design Flow Rate Calculation Method
  ,                                       !- Design Flow Rate {m3/s}
  ,                                       !- Flow Rate per Floor Area {m3/s-m2}
  ,                                       !- Flow Rate per Exterior Surface Area {m3/s-m2}
  {{ infiltrationRate }},                                    !- Air Changes per Hour {1/hr}
  ,                                       !- Constant Term Coefficient
  ,                                       !- Temperature Term Coefficient
  ,                                       !- Velocity Term Coefficient
  ;                                       !- Velocity Squared Term Coefficient

Schedule:Constant,
  schedule_infiltration_fl{{ fl }}_thz0,         !- Name
  FRACTIONAL,                               !- Schedule Type Limits Name
  1;                                      !- Hourly Value

{% endfor %}

!- END infiltration

