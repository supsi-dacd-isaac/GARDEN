  Water,                                  !- Fluid Type
  ,                                       !- User Defined Fluid Type
  plantloop_gen Operation Schemes,        !- Plant Equipment Operation Scheme Name
  node_gen_5,                             !- Loop Temperature Setpoint Node Name
  100,                                    !- Maximum Loop Temperature {C}
  0,                                      !- Minimum Loop Temperature {C}
  Autosize,                               !- Maximum Loop Flow Rate {m3/s}
  0,                                      !- Minimum Loop Flow Rate {m3/s}
  Autocalculate,                          !- Plant Loop Volume {m3}
  node_gen_1,                             !- Plant Side Inlet Node Name
  node_gen_5,                             !- Plant Side Outlet Node Name
