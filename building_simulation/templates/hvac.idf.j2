  None;                                   !- Coincident Sizing Factor Mode

SetpointManager:Scheduled,
  setpoint_loop_gen,                      !- Name
  Temperature,                            !- Control Variable
  schedule_setpoint_loop_gen,             !- Schedule Name
  node_gen_5;                             !- Setpoint Node or NodeList Name

Schedule:Constant,
  schedule_setpoint_loop_gen,             !- Name
  ,                                       !- Schedule Type Limits Name
  {{ sh_flow_temperature }};                                     !- Hourly Value

!Schedule:Compact,
!  schedule_setpoint_loop_gen,              !- Name
!  Temperature,                          !- Schedule Type Limits Name
!  Through: 12/31,                       
!  For: AllDays, 
!  Until: {{ hour_start_increase }},                             !- Time preheating N {hh:mm}
!  {{ sh_flow_temperature }},          !- Value Until Time N T preheating
!  Until: {{ hour_stop_increase }},                          !- Time 1 {hh:mm}
!  {{ sh_flow_temperature + increaseTankTemperature }},               !- Value Until Time 1
!  Until: 24:00,                                  !- Time 3 {hh:mm}
!  {{ sh_flow_temperature }};               !- Value Until Time 3

BranchList,
