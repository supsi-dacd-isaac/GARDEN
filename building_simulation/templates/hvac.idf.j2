{% else %} ! (if IS_HEATPUMP_SH == False)

Branch,
  plantloop_gen Supply Branch 1,          !- Name
  ,                                       !- Pressure Drop Curve Name
  Boiler:HotWater,                        !- Component Object Type 1
  boiler_gen,                             !- Component Name 1
  node_gen_3,                             !- Component Inlet Node Name 1
  node_gen_4;                             !- Component Outlet Node Name 1

PlantEquipmentList,
