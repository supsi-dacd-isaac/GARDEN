{% if IS_HEATPUMP_SH %} ! (if IS_HEATPUMP == True)

Branch,
  plantloop_gen Supply Branch 1,          !- Name
  ,                                       !- Pressure Drop Curve Name
  HeatPump:PlantLoop:EIR:Heating,                        !- Component Object Type 1
  hp_gen,                             !- Component Name 1
  node_gen_3,                             !- Component Inlet Node Name 1
  node_gen_4;                             !- Component Outlet Node Name 1

PlantEquipmentList,
  plantloop_gen Heating Equipment List,   !- Name
  HeatPump:PlantLoop:EIR:Heating,                        !- Equipment Object Type 1
  hp_gen;                             !- Equipment Name 1

HeatPump:PlantLoop:EIR:Heating,
  hp_gen,            !- Name
  node_gen_3, !- Load Side Inlet Node Name
  node_gen_4,  !- Load Side Outlet Node Name
  AirSource,             ! Condenser Type
  node_outdoor_air,  !- Source Side Inlet Node Name
  node_exhaust_air,  !- Source Side Outlet Node Name
